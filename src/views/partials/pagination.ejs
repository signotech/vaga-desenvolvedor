<% if (typeof pagination !== 'undefined' && pagination.total > 0) { %>
  <div class="row pagination-bar">
    <div class="col s12 m7">
      <span class="grey-text text-darken-1">
        Mostrando <%= pagination.from %>–<%= pagination.to %> de <%= pagination.total %> registro(s)
      </span>
    </div>

    <div class="col s12 m5">
      <div class="per-page-wrapper">
        <label for="per-page">Itens por página</label>
        <select id="per-page" class="browser-default" data-per-page>
          <% perPageOptions.forEach((option) => { %>
            <option value="<%= option %>" <%= option === pagination.perPage ? 'selected' : '' %>>
              <%= option %>
            </option>
          <% }); %>
        </select>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col s12 right-align">
      <ul class="pagination">
        <li class="<%= pagination.hasPrevious ? 'waves-effect' : 'disabled' %>">
          <a href="?<%= queryString(query, { page: pagination.page - 1 }) %>">
            <i class="material-icons">chevron_left</i>
          </a>
        </li>

        <% pageRange(pagination.page, pagination.lastPage).forEach((page) => { %>
          <% if (page === '...') { %>
            <li class="disabled"><a>…</a></li>
          <% } else { %>
            <li class="<%= page === pagination.page ? 'active blue' : 'waves-effect' %>">
              <a href="?<%= queryString(query, { page }) %>"><%= page %></a>
            </li>
          <% } %>
        <% }); %>

        <li class="<%= pagination.hasNext ? 'waves-effect' : 'disabled' %>">
          <a href="?<%= queryString(query, { page: pagination.page + 1 }) %>">
            <i class="material-icons">chevron_right</i>
          </a>
        </li>
      </ul>
    </div>
  </div>
<% } %>
