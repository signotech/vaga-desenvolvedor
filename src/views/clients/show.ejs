<div class="row valign-wrapper">
  <div class="col s12 m8">
    <h4><%= client.name %></h4>
  </div>
  <div class="col s12 m4 right-align">
    <a href="/clients" class="btn-flat">Voltar</a>
    <a href="/clients/<%= client.id %>/edit" class="btn blue darken-2">
      <i class="material-icons left">edit</i>
      Editar
    </a>
  </div>
</div>

<div class="card">
  <div class="card-content">
    <div class="row">
      <div class="col s12 m4">
        <p class="grey-text no-margin">CPF</p>
        <p><%= formatCpf(client.cpf) %></p>
      </div>
      <div class="col s12 m4">
        <p class="grey-text no-margin">E-mail</p>
        <p><%= client.email %></p>
      </div>
      <div class="col s12 m4">
        <p class="grey-text no-margin">Cadastrado em</p>
        <p><%= formatDateTime(client.createdAt) %></p>
      </div>
    </div>
  </div>
</div>

<h5>Pedidos recentes</h5>

<% if (orders.length === 0) { %>
  <div class="card-panel grey lighten-4 center-align">
    Este cliente ainda não possui pedidos.
  </div>
<% } else { %>
  <table class="striped responsive-table">
    <thead>
      <tr>
        <th>#</th>
        <th>Data</th>
        <th>Status</th>
        <th class="right-align">Total</th>
      </tr>
    </thead>
    <tbody>
      <% orders.forEach((order) => { %>
        <tr>
          <td><%= order.id %></td>
          <td><%= formatDateTime(order.orderedAt) %></td>
          <td>
            <span class="status-badge <%= statusClass(order.status) %>">
              <%= statusLabel(order.status) %>
            </span>
          </td>
          <td class="right-align"><%= formatMoney(order.total) %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
<% } %>
