<div class="row valign-wrapper">
  <div class="col s12 m8">
    <h4><%= product.title %></h4>
    <p class="grey-text no-margin">SKU: <%= product.sku %></p>
  </div>
  <div class="col s12 m4 right-align">
    <a href="/products" class="btn-flat">Voltar</a>
    <a href="/products/<%= product.id %>/edit" class="btn blue darken-2">
      <i class="material-icons left">edit</i>
      Editar
    </a>
  </div>
</div>

<div class="card">
  <div class="card-content">
    <div class="row">
      <div class="col s12 m3">
        <p class="grey-text no-margin">Preço</p>
        <p><%= formatMoney(product.price) %></p>
      </div>
      <div class="col s12 m3">
        <p class="grey-text no-margin">Estoque</p>
        <p><%= product.stock %> unidade(s)</p>
      </div>
      <div class="col s12 m3">
        <p class="grey-text no-margin">Cadastrado em</p>
        <p><%= formatDateTime(product.createdAt) %></p>
      </div>
      <div class="col s12 m3">
        <p class="grey-text no-margin">Atualizado em</p>
        <p><%= formatDateTime(product.updatedAt) %></p>
      </div>
    </div>
  </div>
</div>

<h5>Pedidos recentes com este produto</h5>

<% if (items.length === 0) { %>
  <div class="card-panel grey lighten-4 center-align">
    Este produto ainda não foi usado em nenhum pedido.
  </div>
<% } else { %>
  <table class="striped responsive-table">
    <thead>
      <tr>
        <th>Pedido</th>
        <th>Cliente</th>
        <th>Data</th>
        <th class="right-align">Qtd.</th>
        <th class="right-align">Preço unit.</th>
        <th class="right-align">Subtotal</th>
      </tr>
    </thead>
    <tbody>
      <% items.forEach((item) => { %>
        <tr>
          <td><%= item.orderId %></td>
          <td>
            <a href="/clients/<%= item.order.client.id %>">
              <%= item.order.client.name %>
            </a>
          </td>
          <td><%= formatDateTime(item.order.orderedAt) %></td>
          <td class="right-align"><%= item.quantity %></td>
          <td class="right-align"><%= formatMoney(item.unitPrice) %></td>
          <td class="right-align">
            <%= formatMoney(item.quantity * item.unitPrice) %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
<% } %>
