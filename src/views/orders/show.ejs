<div class="row valign-wrapper">
  <div class="col s12 m8">
    <h4>
      Pedido #<%= order.id %>
      <span class="status-badge <%= statusClass(order.status) %>">
        <%= statusLabel(order.status) %>
      </span>
    </h4>
  </div>
  <div class="col s12 m4 right-align">
    <a href="/orders" class="btn-flat">Voltar</a>
    <a href="/orders/<%= order.id %>/edit" class="btn blue darken-2">
      <i class="material-icons left">edit</i>
      Editar
    </a>
  </div>
</div>

<div class="card">
  <div class="card-content">
    <div class="row">
      <div class="col s12 m4">
        <p class="grey-text no-margin">Cliente</p>
        <p>
          <a href="/clients/<%= order.client.id %>"><%= order.client.name %></a>
        </p>
      </div>
      <div class="col s12 m4">
        <p class="grey-text no-margin">Data do pedido</p>
        <p><%= formatDateTime(order.orderedAt) %></p>
      </div>
      <div class="col s12 m4">
        <p class="grey-text no-margin">Cadastrado em</p>
        <p><%= formatDateTime(order.createdAt) %></p>
      </div>
    </div>
  </div>
</div>

<h5>Itens do pedido</h5>

<table class="striped responsive-table">
  <thead>
    <tr>
      <th>Produto</th>
      <th class="right-align">Qtd.</th>
      <th class="right-align">Preço unit.</th>
      <th class="right-align">Subtotal</th>
    </tr>
  </thead>
  <tbody>
    <% order.items.forEach((item) => { %>
      <tr>
        <td>
          <a href="/products/<%= item.product.id %>"><%= item.product.title %></a>
          <br>
          <small class="grey-text"><%= item.product.sku %></small>
        </td>
        <td class="right-align"><%= item.quantity %></td>
        <td class="right-align"><%= formatMoney(item.unitPrice) %></td>
        <td class="right-align">
          <%= formatMoney(Number(item.quantity) * Number(item.unitPrice)) %>
        </td>
      </tr>
    <% }); %>
  </tbody>
</table>

<div class="row">
  <div class="col s12 m5 offset-m7">
    <table class="summary-table">
      <tr>
        <td>Subtotal</td>
        <td class="right-align"><%= formatMoney(order.subtotal) %></td>
      </tr>
      <tr>
        <td>
          Desconto
          <% if (order.discountType === 'percent') { %>
            (<%= Number(order.discountValue) %>%)
          <% } else if (order.discountType === 'fixed') { %>
            (fixo)
          <% } %>
        </td>
        <td class="right-align">− <%= formatMoney(order.discountAmount) %></td>
      </tr>
      <tr>
        <td><strong>Total</strong></td>
        <td class="right-align"><strong><%= formatMoney(order.total) %></strong></td>
      </tr>
    </table>
  </div>
</div>
