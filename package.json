{
  "name": "vaga-desenvolvedor",
  "version": "1.0.0",
  "description": "Cadastro de pedidos de compra (Node.js + Express + Sequelize + SQLite)",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:reset": "sequelize-cli db:migrate:undo:all && npm run db:setup",
    "test": "node --test tests/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manoelasz/vaga-desenvolvedor.git"
  },
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5"
  }
}
