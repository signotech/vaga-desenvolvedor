generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
    COMPANY
    CANDIDATE 
    ADMIN
}

enum JobType {
	CLT
	PJ
	FREELANCE
}

enum JobStatus {
	IN_PROGRESS
	PAUSED
	FINISHED
	CANCELLED
}

model User {
	id Int @id @default(autoincrement())
	name String
	email String @unique
	password String
	role Role @default(CANDIDATE)
	phone String?
	bio String?
	portfolio String?
	resumeUrl String?
	active Boolean @default(true)
	createdAt DateTime @default(now())
	jobs Job[]
	applications JobApplication[]

    @@map("user")
}

model Job {
	id Int @id @default(autoincrement())
	title String
	type JobType
	description String
	requirements String?
	location String?
	salaryRange String?
	active Boolean @default(true)
	status JobStatus @default(IN_PROGRESS)
	userId Int
	user User @relation(fields: [userId], references: [id])
	candidates JobApplication[]
	createdAt DateTime @default(now())

    @@map("job")
}

model JobApplication {
	id Int @id @default(autoincrement())
	jobId Int
	candidateId Int
	status JobStatus @default(IN_PROGRESS)
	appliedAt DateTime @default(now())
	job Job @relation(fields: [jobId], references: [id])
	candidate User @relation(fields: [candidateId], references: [id])

    @@map("job_application")
}
