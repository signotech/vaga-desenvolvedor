generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
    COMPANY
    CANDIDATE 
    ADMIN
}

model User {
	id Int @id @default(autoincrement())
	name String
	email String @unique
	password String
	role Role @default(CANDIDATE)
	active Boolean @default(true)
	createdAt DateTime @default(now())

    @@map("user")
}

model Job {
	id Int @id @default(autoincrement())
	title String
	type String
	description String
	requirements String?
	location String?
	salaryRange String?
	active Boolean @default(true)
	candidates JobApplication[]
	createdAt DateTime @default(now())

    @@map("job")
}

model Candidate {
	id Int @id @default(autoincrement())
	name String 
	email String @unique
	phone String
	resumeUrl String?
	bio String?
	portfolio String?
	active Boolean @default(true)
	jobs JobApplication[]
	createdAt DateTime @default(now())

    @@map("candidate")
}

model JobApplication {
	id Int @id @default(autoincrement())
	jobId Int
	candidateId Int
	status String
	appliedAt DateTime @default(now())
	job Job @relation(fields: [jobId], references: [id])
	candidate Candidate @relation(fields: [candidateId], references: [id])

    @@map("job_application")
}
